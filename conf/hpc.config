// SLURM execution for the full dataset, including optional raw-read work.
params {
    mode             = 'full'
    acquisition_mode = 'raw_reads'
    models           = ['M0', 'M1', 'M2', 'M3', 'M4', 'M5']
    draws            = 2000
    tune             = 2000
    chains           = 4
    permutations     = 1000
    outdir           = "${projectDir}/results/full"
}
process {
    executor      = 'slurm'
    queue         = System.getenv('EVONEXUS_QUEUE') ?: 'normal'
    clusterOptions = System.getenv('EVONEXUS_CLUSTER_OPTS') ?: ''
    scratch       = true
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139, 140] ? 'retry' : 'finish' }
    maxRetries    = 3

    withLabel: tiny     { cpus = 1;  memory = 4.GB;   time = 1.h  }
    withLabel: light    { cpus = 2;  memory = 8.GB;   time = 4.h  }
    withLabel: standard { cpus = 4;  memory = 16.GB;  time = 12.h }
    withLabel: heavy    { cpus = 16; memory = 64.GB;  time = 72.h }
    withLabel: network  { cpus = 1;  memory = 4.GB;   time = 24.h; maxForks = 4 }
}
executor {
    $slurm {
        queueSize            = 100
        submitRateLimit      = '20/1min'
        pollInterval         = '30 sec'
    }
}

// Deterministic synthetic data. Fast enough for CI; validates the whole DAG.
params {
    mode                     = 'test'
    synthetic                = true
    offline                  = true
    require_mapping_approval = false
    allow_role_guess         = true
    models                   = ['M0', 'M3']
    resolutions              = ['lineage']
    draws                    = 300
    tune                     = 300
    chains                   = 2
    permutations             = 100
    cv_group_columns         = ['site_id']
    cv_folds                 = 3
    run_sensitivity          = false
    outdir                   = "${projectDir}/results/test"
}
process {
    cpus   = 1
    memory = 4.GB
    time   = 30.m
    withLabel: heavy { cpus = 2; memory = 6.GB; time = 1.h }
}

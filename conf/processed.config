// Main analysis from the published processed dataset.
params {
    mode             = 'processed'
    acquisition_mode = 'processed_only'
    models           = ['M0', 'M1', 'M2', 'M3', 'M4']
    resolutions      = ['lineage', 'family', 'strict']
    draws            = 1000
    tune             = 1000
    chains           = 4
    permutations     = 500
    cv_group_columns = ['site_id', 'region']
    outdir           = "${projectDir}/results/processed"
}
process {
    cpus   = 2
    memory = 12.GB
    withLabel: heavy { cpus = 8; memory = 32.GB; time = 24.h }
}

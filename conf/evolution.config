// Molecular evolutionary analyses on selected coding lineages.
params {
    mode        = 'evolution'
    models      = ['M3', 'M5']
    draws       = 1000
    tune        = 1000
    chains      = 4
    outdir      = "${projectDir}/results/evolution"
}
process {
    // Alignment (MAFFT), phylogeny (IQ-TREE 2) and selection (HyPhy) all run
    // inside RUN_EVOLUTION, which is why it gets the largest allocation.
    withName: RUN_EVOLUTION { cpus = 8; memory = 16.GB; time = 48.h }
}

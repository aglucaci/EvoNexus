// Molecular evolutionary analyses on selected coding lineages.
params {
    mode        = 'evolution'
    models      = ['M3', 'M5']
    draws       = 1000
    tune        = 1000
    chains      = 4
    outdir      = "${projectDir}/results/evolution"
}
process {
    withName: ALIGN_SEQUENCES { cpus = 4;  memory = 8.GB;  time = 6.h  }
    withName: INFER_PHYLOGENY { cpus = 8;  memory = 16.GB; time = 24.h }
    withName: TEST_SELECTION  { cpus = 8;  memory = 16.GB; time = 48.h }
}

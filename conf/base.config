// Baseline resource requests. Profiles override these.

process {
    executor      = 'local'
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    cpus   = 1
    memory = 4.GB
    time   = 2.h

    withLabel: tiny     { cpus = 1; memory = 2.GB;  time = 30.m }
    withLabel: light    { cpus = 1; memory = 4.GB;  time = 1.h  }
    withLabel: standard { cpus = 2; memory = 8.GB;  time = 4.h  }
    withLabel: heavy    { cpus = 4; memory = 16.GB; time = 12.h }
    withLabel: network  { cpus = 1; memory = 2.GB;  time = 8.h; maxForks = 2; errorStrategy = 'retry'; maxRetries = 4 }

    withName: FIT_MODEL        { label = 'heavy' }
    withName: CROSS_VALIDATE   { label = 'heavy' }
    withName: ALIGN_SEQUENCES  { label = 'standard' }
    withName: INFER_PHYLOGENY  { label = 'heavy' }
}

executor {
    $local {
        cpus   = Runtime.runtime.availableProcessors()
        memory = '16 GB'
    }
}

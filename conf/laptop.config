// Small verified public subset: exercises metadata handling and modelling
// end to end without an HPC allocation.
params {
    mode             = 'laptop'
    acquisition_mode = 'processed_only'
    models           = ['M0', 'M1', 'M2', 'M3']
    resolutions      = ['lineage', 'family']
    draws            = 500
    tune             = 500
    chains           = 2
    permutations     = 200
    cv_folds         = 3
    outdir           = "${projectDir}/results/laptop"
}
process {
    cpus   = 2
    memory = 8.GB
    withLabel: heavy { cpus = 4; memory = 12.GB; time = 8.h }
}

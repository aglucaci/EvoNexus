docker {
    enabled    = true
    runOptions = '-u $(id -u):$(id -g)'
}
process {
    container = 'ghcr.io/aglucaci/evonexus:0.1.0'
    withName: ALIGN_SEQUENCES { container = 'quay.io/biocontainers/mafft:7.520--hec16e2b_1' }
    withName: INFER_PHYLOGENY { container = 'quay.io/biocontainers/iqtree:2.2.2.7--h21ec9f0_0' }
    withName: TEST_SELECTION  { container = 'quay.io/biocontainers/hyphy:2.5.60--he91c24d_0' }
}

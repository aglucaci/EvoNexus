// The image carries the environment, not the code: `env.PYTHONPATH` points at
// `${projectDir}/scripts` on the host, so the project directory must be bound
// into the container or every task fails with ModuleNotFoundError: evonexus.
// Binding it also keeps the code and the image from drifting apart, which
// baking the package into the image would invite.
docker {
    enabled    = true
    runOptions = "-u \$(id -u):\$(id -g) -v ${projectDir}:${projectDir}"
}
process {
    // One image for every process. The evolutionary stage shells out to
    // MAFFT, IQ-TREE 2 and HyPhy, so the image must carry all three; the
    // project image is built from environment.yml, which installs them.
    // Build it from the repository Dockerfile and push it, or point
    // `--container` at your own tag. It is not published for you.
    container = params.container ?: 'ghcr.io/aglucaci/evonexus:0.1.0'
}

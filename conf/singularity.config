singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${projectDir}/.singularity"
}
process {
    // One image for every process. The evolutionary stage shells out to
    // MAFFT, IQ-TREE 2 and HyPhy, so the image must carry all three; the
    // project image is built from environment.yml, which installs them.
    // Build it from the repository Dockerfile and push it, or point
    // `--container` at your own tag. It is not published for you.
    container = params.container ?: 'ghcr.io/aglucaci/evonexus:0.1.0'
}

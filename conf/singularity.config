singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${projectDir}/.singularity"
}
process {
    container = 'ghcr.io/aglucaci/evonexus:0.1.0'
    withName: ALIGN_SEQUENCES { container = 'https://depot.galaxyproject.org/singularity/mafft:7.520--hec16e2b_1' }
    withName: INFER_PHYLOGENY { container = 'https://depot.galaxyproject.org/singularity/iqtree:2.2.2.7--h21ec9f0_0' }
    withName: TEST_SELECTION  { container = 'https://depot.galaxyproject.org/singularity/hyphy:2.5.60--he91c24d_0' }
}

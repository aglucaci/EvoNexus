    given-names: Alexander
    affiliation: "Weill Cornell Medicine"
    email: agl4001@med.cornell.edu
keywords:
  - bioinformatics
  - metatranscriptomics
  - Bayesian hierarchical models
  - viral ecology
  - molecular evolution
  - Nextflow
  - reproducibility
references:

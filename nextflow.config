// EvoNexus — Nextflow DSL2 pipeline configuration.

manifest {
    name            = 'evonexus'
    author          = 'Alexander Lucaci'
    description     = 'Evolutionary and ecological networks of viral host sharing in bats'
    homePage        = 'https://github.com/aglucaci/evonexus'
    mainScript      = 'main.nf'
    version         = '0.1.0'
    nextflowVersion = '>=23.10.0'
}

nextflow.enable.dsl = 2

params {
    // ---- mode -------------------------------------------------------
    mode              = 'processed'       // test | laptop | processed | full | evolution | manuscript
    synthetic         = false
    acquisition_mode  = 'processed_only'  // processed_only | raw_reads
    offline           = false

    // ---- paths ------------------------------------------------------
    outdir            = "${projectDir}/results"
    datadir           = "${projectDir}/data"
    config_dir        = "${projectDir}/config"
    scripts_dir       = "${projectDir}/scripts"
    sequences         = null               // viral FASTA for the evolution workflow
    host_newick       = null               // bat phylogeny for model M5
    mapping_overrides = null

    // ---- metadata harmonization -------------------------------------
    require_mapping_approval = true
    allow_role_guess         = false

    // ---- quality gates ----------------------------------------------
    // When a critical gate fails the primary model is skipped and the
    // descriptive branch runs instead. Set to true to abort the run outright.
    fail_on_critical_gate = false

    // ---- modelling ---------------------------------------------------
    models            = ['M0', 'M1', 'M2', 'M3', 'M4']
    primary_model     = 'M3'
    prior_variant     = 'regularizing'
    engine            = 'auto'             // auto | pymc_nuts | polya_gamma_gibbs
    draws             = 1000
    tune              = 1000
    chains            = 4
    seed              = 20250101
    resolutions       = ['lineage', 'family', 'strict']
    run_sensitivity   = true

    // ---- connectivity / validation ------------------------------------
    permutations      = 500
    cv_group_columns  = ['site_id', 'region']
    cv_folds          = 5

    // ---- reporting -----------------------------------------------------
    skip_report       = false

    // ---- housekeeping ---------------------------------------------------
    publish_mode      = 'copy'
    tracedir          = "${params.outdir}/pipeline_info"
    help              = false
}

// Every process runs the package from `scripts/` with the repository's config.
env {
    PYTHONPATH        = "${params.scripts_dir}"
    EVONEXUS_CONFIG_DIR = "${params.config_dir}"
    PYTHONNOUSERSITE  = '1'
    MPLBACKEND        = 'Agg'
}

profiles {
    test        { includeConfig 'conf/test.config'        }
    laptop      { includeConfig 'conf/laptop.config'      }
    processed   { includeConfig 'conf/processed.config'   }
    full        { includeConfig 'conf/hpc.config'         }
    evolution   { includeConfig 'conf/evolution.config'   }
    manuscript  { includeConfig 'conf/manuscript.config'  }
    docker      { includeConfig 'conf/docker.config'      }
    singularity { includeConfig 'conf/singularity.config' }
    hpc         { includeConfig 'conf/hpc.config'         }
    conda {
        conda.enabled   = true
        process.conda   = "${projectDir}/environment.yml"
    }
}

includeConfig 'conf/base.config'

// Completion handlers live here rather than in main.nf: Nextflow's strict
// syntax does not allow statements alongside script declarations, so
// `workflow.onComplete { ... }` at the end of a script is a parse error.
workflow.onComplete = {
    // `log` is null in a config closure; println goes to the console.
    println """
    ===========================================================================
    EvoNexus finished: ${workflow.success ? 'OK' : 'FAILED'}
    Duration   : ${workflow.duration}
    Results    : ${params.outdir}
    QC report  : ${params.outdir}/qc/qc_report.md
    Run report : ${params.outdir}/manuscript/analysis_report.md
    ---------------------------------------------------------------------------
    Read the QC report before any result. A critical gate failure means the
    primary settlement-versus-wild analysis was NOT run, and only descriptive
    outputs are present.
    ===========================================================================
    """.stripIndent()
}

workflow.onError = {
    println "EvoNexus stopped: ${workflow.errorMessage}"
}

timeline { enabled = true; file = "${params.tracedir}/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.tracedir}/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.tracedir}/trace.txt";     overwrite = true }
dag      { enabled = true; file = "${params.tracedir}/dag.html";      overwrite = true }

cleanup = false
